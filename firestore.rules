rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ubicación compartida (historia 8): shares/{uid del dueño}
    // - Escribe solo el dueño.
    // - Lee el dueño y los correos incluidos en "allowed".
    match /shares/{uid} {
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.token.email in resource.data.allowed);
    }

    // Reseñas de restaurantes: restaurants/{id}/reviews/{uid del autor}
    // - Leen todas las personas con sesión.
    // - Cada persona escribe solo su propia reseña (una por restaurante), con 1 a 5 estrellas,
    //   texto de hasta 1000 caracteres y, si hay, una foto Base64 de hasta 400.000 caracteres.
    match /restaurants/{restaurantId}/reviews/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && request.resource.data.userName is string
        && (!('photo' in request.resource.data)
            || (request.resource.data.photo is string && request.resource.data.photo.size() <= 400000));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
